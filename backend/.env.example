# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meditrack
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT — change this to a long random secret in production
JWT_SECRET=meditrack_change_me_to_a_long_random_secret_key_32chars
JWT_EXPIRES_IN=7d

# Email (use App Password for Gmail; leave blank to disable email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MediTrack <noreply@meditrack.local>"

# Optional: OpenAI for floating chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Free AI providers (pick at least one) ---
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional paid OpenAI (only used if free providers fail / missing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
